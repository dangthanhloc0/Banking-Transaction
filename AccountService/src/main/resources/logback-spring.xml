<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <springProperty scope="context" name="spring.application.name" source="spring.application.name"/>

    <!-- one folder per service, so Filebeat can read logs/*/application.log -->
    <property name="LOG_PATH" value="logs/${spring.application.name:-app}"/>

    <!-- Console: readable text; traceId/spanId come from the MDC filled by Micrometer Tracing -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${spring.application.name:-app}/${INSTANCE_ID:-local}] [traceId=%X{traceId:-} spanId=%X{spanId:-}] [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <!-- File: one JSON object per line; every MDC key (traceId, spanId) is a JSON field -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/application.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/application-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${spring.application.name:-app}","instance":"${INSTANCE_ID:-local}"}</customFields>
            <!-- the app name is already in customFields; the dotted context key would only add noise -->
            <includeContext>false</includeContext>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
